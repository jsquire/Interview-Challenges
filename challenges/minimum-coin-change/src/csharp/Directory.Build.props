<Project>
  <Import Project="..\..\..\..\Directory.Build.props" />

  <PropertyGroup>
    <Product>Minimum Coin Challenge</Product>
    <Version>0.0.1-dev.1</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Pre-existing test code predates the repo-wide .NET analyzers; suppress the
